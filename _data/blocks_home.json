/\u003e\u003crect x=\"64\" y=\"444\" width=\"28\" height=\"40\" fill=\"#cdd6bd\" stroke=\"#9aa68a\"/\u003e\u003crect x=\"112\" y=\"444\" width=\"28\" height=\"40\" fill=\"#cdd6bd\" stroke=\"#9aa68a\"/\u003e\u003crect x=\"160\" y=\"444\" width=\"28\" height=\"40\" fill=\"#cdd6bd\" stroke=\"#9aa68a\"/\u003e\u003crect x=\"208\" y=\"444\" width=\"28\" height=\"40\" fill=\"#cdd6bd\" stroke=\"#9aa68a\"/\u003e\u003crect x=\"146\" y=\"38\" width=\"16\" height=\"14\" rx=\"2\" fill=\"#95d600\" stroke=\"#3f6b00\" stroke-width=\"2\"/\u003e\u003cpath class=\"ex-rope2\" pathLength=\"1\" d=\"M168 52V304\" fill=\"none\" stroke=\"#7a8574\" stroke-width=\"2\"/\u003e\u003cpath class=\"ex-rope\" pathLength=\"1\" d=\"M154 52V330\" fill=\"none\" stroke=\"#2a323a\" stroke-width=\"3\"/\u003e\u003cg transform=\"translate(154 330) scale(1.25)\"\u003e\u003cg class=\"ex-man\"\u003e\u003cg class=\"ex-sway\"\u003e\u003cellipse cx=\"14\" cy=\"8\" rx=\"28\" ry=\"50\" fill=\"#15191d\" opacity=\".08\"/\u003e\u003cg class=\"ex-legs\"\u003e\u003cpath d=\"M-7 2L-19 22L-14 42M7 2L19 22L14 40\" fill=\"none\" stroke=\"#3b4a5a\" stroke-width=\"9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/\u003e\u003cellipse cx=\"-14\" cy=\"46\" rx=\"8\" ry=\"4.5\" fill=\"#1c2125\"/\u003e\u003cellipse cx=\"14\" cy=\"44\" rx=\"8\" ry=\"4.5\" fill=\"#1c2125\"/\u003e\u003c/g\u003e\u003cpath d=\"M0 2C-2 14 4 24 -2 34\" fill=\"none\" stroke=\"#2a323a\" stroke-width=\"2.5\" stroke-linecap=\"round\"/\u003e\u003crect x=\"-14\" y=\"-8\" width=\"28\" height=\"9\" rx=\"3\" fill=\"#2a323a\"/\u003e\u003cpath d=\"M-14 -33Q0 -38 14 -33L12 -6H-12Z\" fill=\"#95d600\"/\u003e\u003cpath d=\"M-9 -34L5 -9M9 -34L-5 -9\" fill=\"none\" stroke=\"#15191d\" stroke-width=\"2.5\"/\u003e\u003crect x=\"-13\" y=\"-16\" width=\"26\" height=\"4\" fill=\"#eef1e8\"/\u003e\u003crect x=\"-9\" y=\"-31\" width=\"18\" height=\"11\" rx=\"3\" fill=\"#2f3a42\"/\u003e\u003cpath d=\"M-13 -30L-19 -46L-3 -64\" fill=\"none\" stroke=\"#7fb800\" stroke-width=\"7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/\u003e\u003ccircle cx=\"-1\" cy=\"-65\" r=\"4\" fill=\"#2a323a\"/\u003e\u003cpath d=\"M13 -30L20 -16L9 -5\" fill=\"none\" stroke=\"#7fb800\" stroke-width=\"7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/\u003e\u003ccircle cx=\"8\" cy=\"-4\" r=\"4\" fill=\"#2a323a\"/\u003e\u003crect x=\"-3.5\" y=\"-38\" width=\"7\" height=\"7\" rx=\"2\" fill=\"#c98f6b\"/\u003e\u003cpath d=\"M-11 -41a11 10 0 0 1 22 0v3h-22z\" fill=\"#ffffff\" stroke=\"#b9c0b0\"/\u003e\u003crect x=\"-2.5\" y=\"-51\" width=\"5\" height=\"12\" fill=\"#95d600\"/\u003e\u003crect x=\"-12\" y=\"-40\" width=\"24\" height=\"3\" rx=\"1.5\" fill=\"#dfe4d6\"/\u003e\u003c/g\u003e\u003c/g\u003e\u003c/g\u003e\u003c/svg\u003e\u003cul class=\"ex-stats\"\u003e\u003cli\u003e\u003cb class=\"ex-num\"\u003e\u0026minus;40%\u003c/b\u003e\u003cspan class=\"ex-lab\"\u003esui costi rispetto al ponteggio\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cb class=\"ex-num\"\u003e\u0026lt;60\u0026prime;\u003c/b\u003e\u003cspan class=\"ex-lab\"\u003eper raggiungere ogni punto\u003c/span\u003e\u003c/li\u003e\u003cli\u003e\u003cb class=\"ex-num\"\u003e0\u003c/b\u003e\u003cspan class=\"ex-lab\"\u003eponteggi, 0 impalcature\u003c/span\u003e\u003c/li\u003e\u003c/ul\u003e\u003c/figure\u003e\u003c/div\u003e\u003c/header\u003e\u003cscript\u003e(function(){function s(){var m=document.querySelector(\u0027.masthead\u0027);if(m)document.documentElement.style.setProperty(\u0027--mh\u0027,m.offsetHeight+\u0027px\u0027)}s();window.addEventListener(\u0027resize\u0027,s)})()\u003c/script\u003e"
